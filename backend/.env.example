# Database
PORT=5001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warrantyvault

# SMTP (optional; dashboard reminders work without these values)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="WarrantyVault <reminders@example.com>"

# Runs at 08:00 each day in the selected IANA timezone.
REMINDER_CRON="0 8 * * *"
REMINDER_TIMEZONE=Asia/Kolkata
